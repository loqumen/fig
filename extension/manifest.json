{
  "manifest_version": 3,
  "name": "Fig",
  "version": "0.1.6",
  "description": "Annotate any page, press Fig, and a revised page is generated from your markings.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:41414/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fig \u2014 annotate this page (\u2325\u21e7F)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-fig": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Toggle the Fig annotation tools on the current page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/josefin-sans-500.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}